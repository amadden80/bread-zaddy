# ───────────────────────────────────────────────
# OS / Filesystem cruft
# ───────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# ───────────────────────────────────────────────
# Editors / IDEs
# ───────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.bak
*.tmp
*.orig
.history/
.netrwhist
nbproject/

# ───────────────────────────────────────────────
# Node / JS tooling (mobile build, if ever reintroduced)
# ───────────────────────────────────────────────
node_modules/
jspm_packages/
.npm/
.yarn/
.yarn-integrity
.pnp.*
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.vite/
.turbo/

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ───────────────────────────────────────────────
# Build / output / dist
# ───────────────────────────────────────────────
dist/
build/
out/
temp/
.output/
.next/
.nuxt/
.svelte-kit/
coverage/
*.tsbuildinfo

# ───────────────────────────────────────────────
# Environment / secrets — never commit these
# ───────────────────────────────────────────────
.env
.env.*
!.env.example
*.local
secrets.json
*.pem
*.key

# ───────────────────────────────────────────────
# Logs / runtime
# ───────────────────────────────────────────────
*.log
logs/
pids/
*.pid
*.seed

# NOTE: public/radio/*.mp3 are shared game assets — intentionally NOT ignored.
